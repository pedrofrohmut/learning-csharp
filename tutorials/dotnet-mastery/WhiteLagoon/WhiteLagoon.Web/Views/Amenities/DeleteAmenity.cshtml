@model WhiteLagoon.Web.Controllers.DeleteAmenityModel;

<div class="w-100 card border-0 p-4">

  <div class="card-header bg-success bg-gradient ml-0 py-3">
    <div class="row">
      <div class="col-12 text-center">
        <h2 class="text-white py-2">Delete Amenity</h2>
      </div>
    </div>
  </div>

  <div class="card-body border-0 p-4">

    <form class="forms row p-3" method="post" asp-controller="Amenities" asp-action="Delete">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>

      <input asp-for="@Model.Id" type="hidden" />

      <div class="form-floating col-12">
        <input asp-for="@Model.Name" class="form-control border shadow" disabled/>
        <label asp-for="Name" class="ms-2 mt-1">Name</label>
      </div>

      <div class="form-floating col-12">
        <input asp-for="@Model.Description" class="form-control border shadow" disabled/>
        <label asp-for="Description" class="ms-2 mt-1">Description</label>
      </div>

      <div class="form-floating col-12">
        <input asp-for="@Model.VillaName" class="form-control border shadow" disabled/>
        <label class="ms-2 mt-1">Villa</label>
      </div>

      <div class="row">
        <div class="col-6 col-md-3">
          <button type="submit" class="btn btn-danger py-2 w-100">
            <i class="bi bi-trash-fill"></i> Delete
          </button>
        </div>

        <div class="col-6 col-md-3">
          <a asp-controller="Amenities" asp-action="Index" class="btn btn-secondary w-100">
            <i class="bi bi-x-circle"></i> Cancel
          </a>
        </div>
      </div>
    </form>

  </div>

</div>
