<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WhiteLagoon.Web</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- <link rel="stylesheet" href="~/WhiteLagoon.Web.styles.css" asp-append-version="true" /> -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  </head>
  <body>
    <header>
      <nav class="layout__navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
        <div class="container">
          <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img alt="" src="~/images/resort.png" height="35"/>
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                  aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
              <li class="nav-item">
                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-light" asp-controller="Home" asp-action="Privacy">Privacy</a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-light" asp-controller="Villas" asp-action="Index">Villas</a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-light" asp-controller="VillaNumbers" asp-action="Index">Villa Numbers</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main role="main" class="layout__main-content container">
      @RenderBody()
    </main>

    <footer class="layout__footer">
      <div class="container">&copy; 2025 - WhiteLagoon</div>
    </footer>

<!--JS Scripts -------------------------------------------------------------------------------------------------------------------->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @if (TempData["error"] != null)
    {
      <script type="text/javascript">
        toastr.error('@TempData["error"]');
      </script>
    }

    @if (TempData["success"] != null)
    {
      <script type="text/javascript">
        toastr.success('@TempData["success"]');
      </script>
    }

    @if (TempData["debug"] != null)
    {
      <script type="text/javascript">
        toastr.info('@TempData["debug"]', '', { timeOut: 5000 });
      </script>
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" />

    @await RenderSectionAsync("Scripts", required: false)
  </body>
</html>
