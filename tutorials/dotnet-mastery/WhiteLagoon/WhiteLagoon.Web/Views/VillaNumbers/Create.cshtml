<!-- AspNetCore auto generates an instance of Villa to be used here -->
@model WhiteLagoon.Web.Controllers.CreateVillaNumberModel;

<div class="w-100 card border-0 p-4">

  <div class="card-header bg-success bg-gradient ml-0 py-3">
    <div class="row">
      <div class="col-12 text-center">
        <h2 class="text-white py-2">Create Villa Number</h2>
      </div>
    </div>
  </div>

  <div class="card-body border-0 p-4">

    <!-- AspFor property bind the value of the input to the Model in this case is the Entity.Villa -->
    <form class="forms row p-3" method="post" asp-controller="VillaNumbers" asp-action="Create">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>

      <div class="form-floating col-12">
        <input type="text" asp-for="@Model.VillaNumber.Number" class="form-control border shadow" />
        <label asp-for="VillaNumber.Number" class="ms-2 mt-1">Villa Number</label>
        <span asp-validation-for="VillaNumber.Number" class="text-danger"></span>
      </div>

      <div class="form-floating col-12">
        <input type="text" asp-for="@Model.VillaNumber.SpecialDetails" class="form-control border shadow" />
        <label asp-for="VillaNumber.SpecialDetails" class="ms-2 mt-1">Special Details</label>
        <span asp-validation-for="VillaNumber.SpecialDetails" class="text-danger"></span>
      </div>

      <div class="form-floating col-12">
        <select asp-for="@Model.VillaNumber.VillaId" class="form-select border shadow">
          <option selected value="0"></option>
          @foreach (var villa in Model.Villas)
          {
            <option value="@villa.Id">@villa.Name</option>
          }
        </select>
        <label class="ms-2 mt-1">Villa</label>
     </div>

      <div class="row">
        <div class="col-6 col-md-3">
          <button type="submit" class="btn btn-primary py-2 w-100">
            <i class="bi bi-check-circle"></i> Submit
          </button>
        </div>

        <div class="col-6 col-md-3">
          <a asp-controller="VillaNumbers" asp-action="Index" class="btn btn-secondary w-100">
            <i class="bi bi-x-circle"></i> Cancel
          </a>
        </div>
      </div>
    </form>

  </div>

</div>


@*
    This stuff adds javascript validation for client side validation (Some jquery
    scafolded scripts)
*@
@section Scripts {
  @{
    <partial name="_ValidationScriptsPartial"/>
  }
}
